---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { referrals } from '../data/links';
---

<Layout title="Links — zouwop">
  <main class="page">
    <div class="container narrow">
      <a class="back" href="/">← zouwop.com</a>
      <h1>Links</h1>
      <p class="intro">Referral offers I actually use. Sign up through these and we both get a bonus.</p>

      <div class="cards">
        {referrals.map((r) => (
          <article class="card">
            <h2 class="name">{r.name}</h2>
            <p class="headline">{r.headline}</p>
            <p class="reward">{r.reward}</p>
            <ol class="steps">
              {r.steps.map((s) => <li>{s}</li>)}
            </ol>
            <div class="code-row">
              <code class="pill">{r.code}</code>
              <button type="button" class="copy" data-code={r.code} aria-describedby={`status-${r.id}`}>
                Copy code
              </button>
            </div>
            <span id={`status-${r.id}`} class="sr-only" aria-live="polite"></span>
            <a class="btn btn-primary cta" href={r.url} target="_blank" rel="noopener noreferrer">Claim $25 →</a>
            {r.terms && <p class="terms">{r.terms}</p>}
          </article>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.querySelectorAll('.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code');
      const status = document.getElementById(btn.getAttribute('aria-describedby'));
      const label = btn.textContent;
      let ok = false;
      try {
        await navigator.clipboard.writeText(code);
        ok = true;
      } catch {
        ok = false;
      }
      if (status) {
        status.textContent = ok ? `Copied ${code}` : 'Copy failed — select the code manually';
      }
      if (ok) {
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = label; }, 1500);
      }
    });
  });
</script>

<style>
  .page { padding: 48px 0 64px; }
  .narrow { max-width: 640px; margin: 0 auto; }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 16px;
  }
  .back:hover { color: var(--orange); }
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .intro { color: var(--text-dim); margin-bottom: 40px; font-size: 1.05rem; }
  .cards { display: flex; flex-direction: column; gap: 24px; }
  .name { font-size: 1.4rem; font-weight: 800; margin-bottom: 4px; }
  .headline {
    font-family: var(--mono);
    color: var(--orange);
    font-size: 0.95rem;
    margin-bottom: 12px;
  }
  .reward { color: var(--text); margin-bottom: 20px; }
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0 0 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--text-dim);
  }
  .steps li {
    counter-increment: step;
    display: flex;
    gap: 12px;
  }
  .steps li::before {
    content: counter(step);
    font-family: var(--mono);
    color: var(--purple);
    flex: 0 0 auto;
  }
  .code-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .pill {
    font-family: var(--mono);
    background: var(--bg);
    border: 1px solid #23232e;
    color: var(--purple);
    padding: 10px 14px;
    border-radius: 8px;
    user-select: all;
  }
  .copy {
    min-height: 44px;
    padding: 0 16px;
    border-radius: 8px;
    background: transparent;
    border: 1px solid #2a2a38;
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .copy:hover { border-color: var(--purple); }
  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    font-size: 1rem;
  }
  .terms { color: var(--text-dim); font-size: 0.75rem; margin-top: 16px; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }
</style>
