---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import { templates } from '../../data/templates';
import { pageExists } from '../../lib/pages';

const hasLicence = pageExists('/licence');
const hasPricing = pageExists('/pricing');
---

<Layout
  title="Templates — Zouwop"
  description="Website templates I build and sell: nine complete sites for trades, restaurants, clinics, studios, musicians and photographers. Licence $500 each."
>
  <main id="main" tabindex="-1" class="page">
    <div class="container">
      <a class="back" href="/">← zouwop.com</a>
      <h1>Templates</h1>
      <p class="intro">
        Complete websites you can buy once and run as your own. Each one is the
        whole site — every page, the styles, the placeholder artwork and a README
        that says what to change. One purchase buys one end product, delivered by
        email within one business day.
      </p>
      {(hasLicence || hasPricing) && (
        <p class="intro-links">
          {hasLicence && <a href="/licence">Read the licence</a>}
          {hasLicence && hasPricing && <span aria-hidden="true"> · </span>}
          {hasPricing && <a href="/pricing">See pricing</a>}
        </p>
      )}

      <div class="catalog">
        {templates.map((entry) => <TemplateCard entry={entry} />)}
      </div>

      <p class="outro">
        Want something built or changed for you? The full build is $2,000 —
        <a href="/#contact">get in touch</a>.
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page {
    padding: 48px 0 64px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 16px;
  }
  .back:hover {
    color: var(--orange);
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .intro {
    color: var(--text-dim);
    margin-bottom: 16px;
    font-size: 1.05rem;
    max-width: 65ch;
  }
  .intro-links {
    margin-bottom: 40px;
  }
  .intro-links a,
  .outro a {
    color: var(--orange);
  }
  .catalog {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 640px) {
    .catalog {
      grid-template-columns: repeat(auto-fit, minmax(520px, 1fr));
    }
  }
  .outro {
    color: var(--text-dim);
    margin-top: 40px;
  }
  a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>
