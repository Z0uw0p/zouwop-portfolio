---
import type { TemplateEntry } from '../../data/templates';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import TemplateFigure from '../../components/TemplateFigure.astro';
import PriceTag from '../../components/PriceTag.astro';
import BuyButton from '../../components/BuyButton.astro';
import StickyBuyBar from '../../components/StickyBuyBar.astro';
import { templates } from '../../data/templates';
import { hasDemo } from '../../data/demos';
import { site } from '../../data/site';
import { pageExists } from '../../lib/pages';
import {
  breadcrumbJsonLd,
  productDescription,
  productJsonLd,
  productTitle,
  seoImagePath,
} from '../../lib/seo';

interface Props {
  entry: TemplateEntry;
}

export function getStaticPaths() {
  return templates.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const baseUrl = Astro.site ?? new URL('https://zouwop.com');

const demoReady = hasDemo(entry.slug);
const previewHref = `/templates/${entry.slug}/preview/`;

const hasLicence = pageExists('/licence');
const others = templates.filter((item) => item.slug !== entry.slug).slice(0, 3);

const isAstro = entry.stack.some((item) => item.startsWith('Astro'));
const needsBuildScript = entry.slug === 'photo-portfolio';

const requirements = isAstro
  ? [
      'Node 22 or newer and npm',
      'A static host — Cloudflare Pages, Netlify, or any web server',
      'Run npm install, then npm run build to get dist/',
    ]
  : needsBuildScript
    ? [
        'Node 22 or newer and npm for the build script',
        'A static host — Cloudflare Pages, Netlify, or any web server',
        'Run the build once, then upload the output',
      ]
    : [
        'No install and no build step — open index.html or serve the folder',
        'Any static host will serve it',
      ];

const faqs = [
  {
    question: 'What do I get for the licence price?',
    answer:
      'The complete source for this template, its placeholder artwork, and the End-Product Licence. One purchase lets you build and run one end product — one website, for one business or one client. You can change the files however you like.',
  },
  {
    question: 'Can I use it for a client’s site?',
    answer:
      'Yes. A client site counts as your one end product. If you want to build the same template again for a second client, you buy a second licence.',
  },
  {
    question: 'How is it delivered?',
    answer:
      'By email within one business day of payment. The email carries the source files and the licence; it is not a support contract, and updates are at my discretion.',
  },
];
---

<Layout
  title={productTitle(entry)}
  description={productDescription(entry)}
  path={`/templates/${entry.slug}/`}
  image={seoImagePath(entry)}
  imageAlt={`${entry.name} template preview`}
  jsonLd={[productJsonLd(entry, baseUrl), breadcrumbJsonLd(entry, baseUrl)]}
>
  <main id="main" tabindex="-1" class="page">
    <div class="container">
      <a class="back" href="/templates/">← Templates</a>

      <article class="product">
        <header class="product-head">
          <p class="eyebrow mono">{entry.niche}</p>
          <h1>{entry.name}</h1>
          <p class="blurb">{entry.blurb}</p>
          <div class="buy-row">
            <BuyButton entry={entry} />
            <a class="btn btn-secondary preview-cta" href={previewHref} aria-describedby="demo-note">
              {demoReady ? 'Preview the live site' : 'Preview coming soon'}
            </a>
          </div>
          <p id="demo-note" class="demo-note">
            The live preview is the template running with placeholder content — nothing you type is saved.
          </p>
          <p class="description">{entry.description}</p>
        </header>

        <TemplateFigure previews={entry.previews} name={entry.name} size="product" />

        <section aria-labelledby="features-heading">
          <h2 id="features-heading">What you get</h2>
          <ul class="feature-list">
            {entry.features.map((feature) => <li>{feature}</li>)}
          </ul>
        </section>

        <section aria-labelledby="zip-heading">
          <h2 id="zip-heading">What’s in the ZIP</h2>
          <ul class="check-list">
            {entry.includes.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section aria-labelledby="stack-heading">
          <h2 id="stack-heading">Stack and requirements</h2>
          <p class="stack mono">{entry.stack.join(' · ')}</p>
          <ul class="check-list">
            {requirements.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section aria-labelledby="hosting-heading">
          <h2 id="hosting-heading">Hosting + maintenance</h2>
          {
            entry.hostedMonthlyCents != null ? (
              <p>
                I host and maintain it for{' '}
                <PriceTag amountCents={entry.hostedMonthlyCents} suffix="/mo" />,
                including updates, backups and small changes.{' '}
                <a href="/pricing#hosted">What hosting covers</a>.
              </p>
            ) : (
              <p>
                I can host and maintain it on zouwop-server, including updates,
                backups and small changes. It is a monthly membership —{' '}
                <a href="/pricing#hosted">see hosting</a> or{' '}
                <a
                  href={`mailto:${site.contact.billing}?subject=${encodeURIComponent(`Hosting — ${entry.name}`)}`}
                >
                  email about hosting
                </a>.
              </p>
            )
          }
        </section>

        <section aria-labelledby="faq-heading">
          <h2 id="faq-heading">Questions</h2>
          <div class="faq">
            {faqs.map((faq) => (
              <div class="faq-item">
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="buy-end" aria-labelledby="buy-end-heading">
          <h2 id="buy-end-heading">Get {entry.name}</h2>
          <BuyButton entry={entry} />
        </section>

        <p class="licence-line">
          Files delivered by email within one business day.
          {hasLicence && <a href="/licence">Read the End-Product Licence</a>}
        </p>
      </article>

      <section class="others" aria-labelledby="others-heading">
        <h2 id="others-heading">Other templates</h2>
        <div class="others-grid">
          {others.map((item) => <TemplateCard entry={item} />)}
        </div>
        <p class="all-link"><a href="/templates/">See all templates →</a></p>
      </section>
    </div>
    <StickyBuyBar entry={entry} />
  </main>
  <Footer />
</Layout>

<style>
  .page {
    padding: 48px 0 64px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 16px;
  }
  .back:hover {
    color: var(--orange);
  }
  .product {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .eyebrow {
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 12px;
    margin-bottom: 8px;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .blurb {
    color: var(--text-dim);
    font-size: 1.05rem;
    max-width: 65ch;
  }
  .buy-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 20px;
  }
  .preview-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
  }
  .demo-note {
    color: var(--text-dim);
    font-size: 0.85rem;
    margin-top: 12px;
    max-width: 65ch;
  }
  .buy-end {
    padding-top: 8px;
  }
  .description {
    color: var(--text-dim);
    margin-top: 20px;
    max-width: 65ch;
  }
  h2 {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: 14px;
  }
  .feature-list,
  .check-list {
    display: grid;
    gap: 10px;
    list-style: none;
    color: var(--text-dim);
  }
  .feature-list li {
    padding-left: 20px;
    position: relative;
  }
  .feature-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--orange);
  }
  .check-list li {
    padding-left: 24px;
    position: relative;
  }
  .check-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--purple);
  }
  .stack {
    color: var(--orange);
    letter-spacing: 0.03em;
    margin-bottom: 14px;
  }
  .faq {
    display: grid;
    gap: 20px;
  }
  .faq-item h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .faq-item p {
    color: var(--text-dim);
    max-width: 65ch;
  }
  .licence-line {
    color: var(--text-dim);
    font-size: 0.9rem;
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }
  .licence-line a {
    color: var(--orange);
  }
  .others {
    margin-top: 56px;
    border-top: 1px solid var(--border);
    padding-top: 40px;
  }
  .others-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 20px;
  }
  @media (max-width: 520px) {
    .others-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }
  .all-link {
    margin-top: 24px;
  }
  .all-link a {
    color: var(--orange);
    font-weight: 600;
    text-decoration: none;
  }
  .all-link a:hover {
    text-decoration: underline;
  }
  a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>
