---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import {
  BILLING_EMAIL,
  DELIVERY_SLA,
  LICENCE_RULE,
  UPDATES_MONTHS,
  SUPPORT_DAYS,
} from '../data/fulfilment';

const updated = '2026-11-08';
---
<Layout
  title="Licence — Zouwop templates"
  description="What one template purchase covers: one end product, edits, updates for 12 months, and 30 days of bug support."
  path="/licence"
>
  <main id="main" tabindex="-1" class="page">
    <div class="container narrow">
      <h1>Licence</h1>
      <p class="meta mono">Updated <time datetime={updated}>{updated}</time></p>

      <div class="card summary">
        <p class="rule">{LICENCE_RULE}</p>
        <ul class="list">
          <li>Use, modify, and publish the template as one website for yourself or one client.</li>
          <li>Unlimited edits. Staging and duplicate copies for testing are fine.</li>
          <li>Remove the footer credit if you want.</li>
        </ul>
      </div>

      <section aria-labelledby="grant">
        <h2 id="grant">You may</h2>
        <p>
          Use the template, modify it, and publish the result as one end product for yourself or
          one client. There is no limit on edits. Copies kept for testing or staging are fine.
        </p>
      </section>

      <section aria-labelledby="limits">
        <h2 id="limits">You may not</h2>
        <ul class="list">
          <li>Resell or redistribute the template or its source as a template.</li>
          <li>Use it in a competing template marketplace.</li>
          <li>Share the ZIP or a modified copy as a download.</li>
          <li>Claim you wrote the template.</li>
        </ul>
      </section>

      <section aria-labelledby="included">
        <h2 id="included">What is included</h2>
        <p>
          The files in the ZIP, the fonts and placeholder art that ship with it, and the build
          scripts. Not included: third-party stock photos or fonts you add, a domain, hosting,
          email, or third-party service fees. Those are yours to licence and pay for.
        </p>
      </section>

      <section aria-labelledby="updates">
        <h2 id="updates">Updates and support</h2>
        <p>
          Bug fixes and template updates are emailed free for {UPDATES_MONTHS} months from
          purchase. Email support covers bugs in the template as shipped for {SUPPORT_DAYS} days;
          I reply {DELIVERY_SLA}. Content changes, new features, hosting, and third-party services
          are not covered.
        </p>
      </section>

      <section aria-labelledby="refunds">
        <h2 id="refunds">Refunds</h2>
        <p>
          Sales are final once the ZIP is emailed, because files cannot be returned. If the ZIP is
          broken or does not match the product page, I will fix it or refund it. Redistribution
          ends the licence with no refund.
        </p>
      </section>

      <section aria-labelledby="transfer">
        <h2 id="transfer">Transfer</h2>
        <p>
          You may hand the licence to a buyer of the end product once, keep no copy, and tell me
          in writing.
        </p>
      </section>

      <p class="contact">
        Questions about the licence? Email
        <a href={`mailto:${BILLING_EMAIL}`}>{BILLING_EMAIL}</a>.
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page { padding: 48px 0 64px; }
  .narrow { max-width: 760px; margin: 0 auto; }
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .meta { color: var(--text-dim); margin-bottom: 32px; }
  .summary { margin-bottom: 32px; }
  .rule { font-size: 1.15rem; font-weight: 600; margin-bottom: 12px; }
  section { margin-bottom: 28px; }
  section h2 { font-size: 1.25rem; margin-bottom: 8px; }
  section p,
  .list {
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  .list {
    list-style: disc;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .contact { color: var(--text-dim); margin-top: 32px; }
  a { color: var(--orange); }
  a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
</style>
