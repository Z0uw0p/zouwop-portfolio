---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { templates } from '../data/templates';
import {
  BILLING_EMAIL,
  DELIVERY_INCLUDES,
  DELIVERY_SLA,
  LICENCE_RULE,
  UPDATES_MONTHS,
} from '../data/fulfilment';

const names = Object.fromEntries(templates.map((template) => [template.slug, template.name]));
const namesJson = JSON.stringify(names).replace(/</g, '\\u003c');
---
<Layout
  title="Thank you — Zouwop"
  description="Your template payment went through. I email the files by hand within one business day."
  path="/thank-you"
  noindex
>
  <main id="main" tabindex="-1" class="page">
    <div class="container narrow">
      <p class="mono eyebrow">order received</p>
      <h1>Thank you</h1>
      <p class="lede" id="lede-generic">
        Your payment went through. I'll email your files by hand.
      </p>
      <p class="lede" id="lede-template" hidden>
        You bought <strong data-template-name></strong>. I'll email your files by hand.
      </p>

      <section class="panel" aria-labelledby="next">
        <h2 id="next">What happens next</h2>
        <p>
          Stripe has taken the payment and sent you a receipt. I prepare every order myself:
          you'll get an email from <a href={`mailto:${BILLING_EMAIL}`}>{BILLING_EMAIL}</a>
          with the files {DELIVERY_SLA}.
        </p>
        <p class="note">
          This is a manual step: there is no automatic download. If more than one business
          day has passed and the email has not arrived, write to
          <a href={`mailto:${BILLING_EMAIL}`}>{BILLING_EMAIL}</a> with the receipt number from
          your Stripe confirmation and I'll find the order and resend it.
        </p>
      </section>

      <section class="panel" aria-labelledby="email">
        <h2 id="email">What's in the email</h2>
        <ul class="list">
          {DELIVERY_INCLUDES.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="panel" aria-labelledby="licence">
        <h2 id="licence">Licence</h2>
        <p>
          {LICENCE_RULE} <a href="/licence">Read the full licence</a> for what the purchase
          covers.
        </p>
      </section>

      <section class="panel" aria-labelledby="changes">
        <h2 id="changes">Changes and fixes</h2>
        <p>
          Bug fixes and template updates are emailed free for {UPDATES_MONTHS} months from
          purchase. Reply to any email about your template and I'll get it.
        </p>
      </section>

      <p class="back">
        <a href="/">Back to zouwop.com</a>
        <span aria-hidden="true">·</span>
        <a href={`mailto:${BILLING_EMAIL}`}>{BILLING_EMAIL}</a>
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<script type="application/json" id="template-names" is:inline set:html={namesJson}></script>
<script is:inline>
  (() => {
    const data = document.getElementById('template-names');
    const generic = document.getElementById('lede-generic');
    const named = document.getElementById('lede-template');
    const slot = document.querySelector('[data-template-name]');
    if (!data || !generic || !named || !slot) return;

    let names = {};
    try {
      names = JSON.parse(data.textContent || '{}');
    } catch {
      return;
    }

    const slug = new URLSearchParams(window.location.search).get('template') || '';
    if (!Object.prototype.hasOwnProperty.call(names, slug)) return;

    const name = names[slug];
    if (typeof name !== 'string' || !name) return;

    slot.textContent = name;
    generic.hidden = true;
    named.hidden = false;
  })();
</script>

<style>
  .page { padding: 48px 0 64px; }
  .narrow { max-width: 760px; margin: 0 auto; }
  .eyebrow { color: var(--text-dim); margin-bottom: 12px; }
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .lede {
    color: var(--text-dim);
    font-size: 1.05rem;
    margin-bottom: 32px;
  }
  .lede strong { color: var(--text); }
  .panel {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    margin-bottom: 20px;
  }
  .panel h2 { font-size: 1.25rem; margin-bottom: 10px; }
  .panel p { color: var(--text-dim); font-size: 0.95rem; }
  .panel a { color: var(--orange); }
  .note { margin-top: 12px; font-size: 0.9rem; }
  .list {
    list-style: disc;
    padding-left: 18px;
    color: var(--text-dim);
    font-size: 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .back {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--orange);
    text-decoration: none;
  }
  .back a:hover { text-decoration: underline; }
  a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
</style>
