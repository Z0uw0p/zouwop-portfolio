---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Portfolio from '../components/Portfolio.astro';
import { portfolio } from '../data/portfolio';
---

<Layout
  title="Portfolio — Zouwop"
  description="Sites I've built, offered as templates. See the live site and the placeholder template."
>
  <main id="main" tabindex="-1" class="page">
    <div class="container">
      <a class="back" href="/">← zouwop.com</a>
      <h1>Portfolio</h1>
      <p class="intro">
        Sites I've built, offered as templates. The live site runs below; the
        template is the same pages with placeholder photos.
      </p>

      <Portfolio entries={portfolio} />
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page {
    padding: 48px 0 64px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 16px;
  }
  .back:hover {
    color: var(--orange);
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .intro {
    color: var(--text-dim);
    margin-bottom: 40px;
    font-size: 1.05rem;
    max-width: 60ch;
  }
  a:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }
</style>
