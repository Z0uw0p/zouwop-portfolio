---
import type { PortfolioEntry } from '../data/portfolio';

interface Props {
  entries: PortfolioEntry[];
}

const { entries } = Astro.props;

const mailto = (email: string, subject: string) =>
  `mailto:${email}?subject=${encodeURIComponent(subject)}`;

const shots = (entry: PortfolioEntry, kind: 'desktop' | 'mobile') =>
  entry.screenshots.filter((shot) => shot.kind === kind);

const host = (url: string) => {
  try {
    return new URL(url).host;
  } catch {
    return url;
  }
};
---

{
  entries.map((entry) => (
    <article class="card entry" id={entry.id}>
      <header class="entry-head">
        <p class="kicker mono">Live site</p>
        <h2>{entry.name}</h2>
        <p class="desc">{entry.description}</p>
        <a class="live" href={entry.liveUrl} target="_blank" rel="noopener noreferrer">
          View the live site <span aria-hidden="true">→</span>
        </a>
      </header>

      {entry.embedUrl && (
        <figure class="embed">
          <iframe
            src={entry.embedUrl}
            title={`${entry.name} — live site`}
            loading="lazy"
            referrerpolicy="no-referrer"
          />
          <figcaption>
            <span>Loaded live from <span class="mono">{host(entry.liveUrl)}</span></span>
            <a href={entry.liveUrl} target="_blank" rel="noopener noreferrer">
              Open in a new tab <span aria-hidden="true">↗</span>
            </a>
          </figcaption>
        </figure>
      )}

      <section class="template" aria-labelledby={`template-${entry.id}`}>
        <h3 id={`template-${entry.id}`}>The template</h3>
        <p class="template-note">
          The same pages with placeholder photos and placeholder text — that is what
          you get, ready for your own images.
        </p>

        <div class="shots-desktop">
          {shots(entry, 'desktop').map((shot) => (
            <a
              class="shot"
              href={shot.src}
              data-label={shot.label}
              data-alt={shot.alt}
              aria-haspopup="dialog"
            >
              <img
                src={shot.src}
                alt={shot.alt}
                width="1440"
                height="900"
                loading="lazy"
                decoding="async"
              />
            </a>
          ))}
        </div>

        <div class="shots-mobile">
          {shots(entry, 'mobile').map((shot) => (
            <a
              class="shot phone"
              href={shot.src}
              data-label={shot.label}
              data-alt={shot.alt}
              aria-haspopup="dialog"
            >
              <img
                src={shot.src}
                alt={shot.alt}
                width="390"
                height="844"
                loading="lazy"
                decoding="async"
              />
            </a>
          ))}
        </div>

        <div class="pricing">
          {entry.pricing.map((option) => (
            <div class="price">
              <p class="price-label mono">{option.label}</p>
              <p class="price-value">{option.price}</p>
              <a
                class="btn btn-primary cta"
                href={mailto(entry.buyEmail, option.subject)}
                aria-label={`${option.label}, ${option.price}: email ${entry.buyEmail}`}
              >
                {option.cta}
              </a>
            </div>
          ))}
        </div>

        <p class="fineprint">
          Email {entry.buyEmail} — the subject line is prefilled. Payment and handover by reply.
        </p>
      </section>
    </article>
  ))
}

<dialog class="shot-lightbox" id="portfolio-lightbox" aria-label="Template screenshots">
  <div class="lb-head">
    <span class="lb-counter mono" data-counter></span>
    <button class="lb-close" type="button" data-close aria-label="Close screenshots">✕</button>
  </div>
  <div class="lb-stage">
    <button class="lb-arrow prev" type="button" data-prev aria-label="Previous screenshot">‹</button>
    <img data-img alt="" />
    <button class="lb-arrow next" type="button" data-next aria-label="Next screenshot">›</button>
  </div>
  <p class="lb-caption" data-caption></p>
</dialog>

<script>
  const dialog = document.getElementById('portfolio-lightbox') as HTMLDialogElement | null;

  if (dialog) {
    const stageImg = dialog.querySelector<HTMLImageElement>('[data-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-counter]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-next]')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-close]')!;

    type Shot = { src: string; label: string; alt: string };
    let items: Shot[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    const render = () => {
      const item = items[index];
      if (!item) return;
      stageImg.src = item.src;
      stageImg.alt = item.alt;
      caption.textContent = item.label;
      counter.textContent = `${index + 1} / ${items.length}`;
      const single = items.length < 2;
      prev.disabled = single;
      next.disabled = single;
    };

    const step = (delta: number) => {
      if (items.length < 2) return;
      index = (index + delta + items.length) % items.length;
      render();
    };

    const open = (list: Shot[], start: number, from: HTMLElement) => {
      items = list;
      index = start;
      opener = from;
      render();
      dialog.showModal();
      document.documentElement.classList.add('lb-open');
    };

    document.querySelectorAll<HTMLAnchorElement>('.shot').forEach((link) => {
      link.addEventListener('click', (event) => {
        const entry = link.closest('.entry');
        if (!entry) return;
        const links = Array.from(entry.querySelectorAll<HTMLAnchorElement>('.template .shot'));
        const list: Shot[] = links.map((el) => ({
          src: el.getAttribute('href') || '',
          label: el.dataset.label || '',
          alt: el.dataset.alt || '',
        }));
        event.preventDefault();
        open(list, Math.max(0, links.indexOf(link)), link);
      });
    });

    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    closeBtn.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      }
    });

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lb-open');
      items = [];
      opener?.focus();
      opener = null;
    });
  }
</script>

<style>
  .entry {
    padding: 20px;
  }
  .entry:hover {
    border-color: var(--border);
    transform: none;
  }
  .kicker {
    color: var(--purple);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.75rem;
    margin-bottom: 6px;
  }
  .entry-head h2 {
    font-size: clamp(1.4rem, 4vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .desc {
    color: var(--text-dim);
    margin-top: 8px;
    max-width: 60ch;
  }
  .live {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    color: var(--orange);
    font-weight: 600;
    text-decoration: none;
  }
  .live span {
    margin-left: 4px;
  }
  .live:hover {
    text-decoration: underline;
  }
  .embed {
    margin-top: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg);
  }
  .embed iframe {
    display: block;
    width: 100%;
    height: clamp(400px, 62vh, 620px);
    border: 0;
  }
  .embed figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    flex-wrap: wrap;
    padding: 0 14px;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.8rem;
  }
  .embed figcaption a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--orange);
    text-decoration: none;
  }
  .embed figcaption a:hover {
    text-decoration: underline;
  }
  .template {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .template h3 {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .template-note {
    color: var(--text-dim);
    margin-top: 6px;
    max-width: 62ch;
    font-size: 0.95rem;
  }
  .shots-desktop {
    display: grid;
    gap: 12px;
    margin-top: 20px;
  }
  .shots-mobile {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 12px;
  }
  .shot {
    display: block;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-soft);
    cursor: zoom-in;
  }
  .shot:hover img {
    opacity: 0.9;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.15s ease;
  }
  .phone img {
    aspect-ratio: 390 / 844;
    object-fit: cover;
    object-position: top;
  }
  .pricing {
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }
  .price {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
  }
  .price-label {
    color: var(--purple);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .price-value {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 8px;
    font-size: 1rem;
  }
  .fineprint {
    color: var(--text-dim);
    font-size: 0.8rem;
    margin-top: 16px;
  }

  /* screenshot carousel */
  html.lb-open {
    overflow: hidden;
  }
  .shot-lightbox {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(1100px, 94vw);
    height: fit-content;
    max-height: 92vh;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-soft);
    color: var(--text);
    overflow: hidden;
  }
  .shot-lightbox::backdrop {
    background: rgba(5, 5, 8, 0.84);
  }
  .lb-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 4px 8px 4px 16px;
    border-bottom: 1px solid var(--border);
  }
  .lb-counter {
    color: var(--text-dim);
    font-size: 0.8rem;
  }
  .lb-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    background: transparent;
    border: 0;
    color: var(--text);
    font-size: 1rem;
    cursor: pointer;
  }
  .lb-close:hover {
    color: var(--orange);
  }
  .lb-stage {
    position: relative;
    background: #08080c;
    padding: 12px;
    min-height: 45vh;
  }
  .lb-stage img {
    display: block;
    margin: 0 auto;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(92vh - 156px);
    object-fit: contain;
  }
  .lb-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: rgba(13, 13, 18, 0.78);
    color: var(--text);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .lb-arrow:hover:not(:disabled) {
    border-color: var(--orange);
    color: var(--orange);
  }
  .lb-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .lb-arrow.prev {
    left: 10px;
  }
  .lb-arrow.next {
    right: 10px;
  }
  .lb-caption {
    padding: 12px 16px;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.85rem;
  }
  .lb-close:focus-visible,
  .lb-arrow:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }

  @media (min-width: 640px) {
    .entry {
      padding: 28px;
    }
    .pricing {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
  }
  @media (min-width: 720px) {
    .shots-desktop {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-top: 24px;
    }
    .shots-mobile {
      grid-template-columns: repeat(6, 1fr);
      gap: 16px;
    }
  }
</style>
