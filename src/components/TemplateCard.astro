---
import type { TemplateEntry } from '../data/templates';
import { hasDemo } from '../data/demos';
import PriceTag from './PriceTag.astro';

interface Props {
  entry: TemplateEntry;
}

const { entry } = Astro.props;
const href = `/templates/${entry.slug}/`;
const previewHref = `/templates/${entry.slug}/preview/`;
const demoHref = `/templates/${entry.slug}/demo/`;
const desktop = entry.previews.find((preview) => preview.kind === 'desktop');
---

<article class="card tpl-card" id={`template-${entry.slug}`}>
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
    {
      desktop ? (
        <img
          src={desktop.src}
          alt=""
          width={desktop.width}
          height={desktop.height}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="thumb-empty" />
      )
    }
  </a>

  <div class="body">
    <div class="row">
      <h2><a href={href}>{entry.name}</a></h2>
      <span class="price"><PriceTag amountCents={entry.priceCents} /></span>
    </div>
    <p class="niche mono">{entry.niche}</p>

    <div class="card-links">
      <a class="details" href={href}>Details</a>
      <a class="preview" href={previewHref}>Preview</a>
      {hasDemo(entry.slug) && <a class="full" href={demoHref}>Full screen</a>}
    </div>
  </div>
</article>

<style>
  .tpl-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 10px;
  }
  .tpl-card:hover {
    border-color: var(--border-hover);
    transform: none;
  }
  .thumb {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .thumb-empty {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--bg);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }
  h2 {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 0;
  }
  h2 a {
    color: var(--text);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--orange);
  }
  .price {
    flex-shrink: 0;
    color: var(--orange);
    font-size: 0.8rem;
  }
  .niche {
    color: var(--text-dim);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .card-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2px 14px;
    margin-top: 2px;
  }
  .card-links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--text-dim);
    font-size: 0.78rem;
    text-decoration: none;
  }
  .card-links a:hover {
    color: var(--orange);
    text-decoration: underline;
  }
  .card-links .preview {
    color: var(--orange);
    font-weight: 600;
  }
  h2 a:focus-visible,
  .card-links a:focus-visible,
  .thumb:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>
