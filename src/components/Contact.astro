---
import { site } from '../data/site';
---
<section id="contact">
  <div class="container center">
    <h2>Get in touch</h2>
    <p class="body">Tell me what you're running, what broke, or what you want to set up. If something is broken, include what you already tried.</p>
    <a class="btn btn-primary" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
    <ul class="alt mono">
      <li><a href={`mailto:${site.contact.booking}`}>Calls: booking@zouwop.com</a></li>
      <li><a href={`mailto:${site.contact.billing}`}>Hosted services: billing@zouwop.com</a></li>
    </ul>
    <p class="note">Email is the only channel right now — no booking calendar yet.</p>
  </div>
</section>

<style>
  .center { text-align: center; }
  .body { color: var(--text-dim); max-width: 560px; margin: 0 auto 32px; }
  .note { color: var(--text-dim); font-size: 0.85rem; margin-top: 16px; }
  .alt { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--text-dim); }
  .alt a { color: var(--text-dim); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .alt a:hover { text-decoration: underline; }
  a:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }
</style>
